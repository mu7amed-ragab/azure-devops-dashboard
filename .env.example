# See README.md for the full setup guide, including how to create and scope the PAT below.

# Azure DevOps organization name (the part before .visualstudio.com or after dev.azure.com/)
ADO_ORG=your-org

# The shared password that gates sign-in. REQUIRED — every deployment has the
# same three-step login (this password, then each person's own PAT, then which
# project to work in), local runs included. Any long, random shared phrase;
# everyone on the team uses the same one as step 1.
APP_PASSWORD=

# Optional: the project preselected on the sign-in project step. Everyone picks
# their own project from the list their own token can read, so this is only a
# default — not a restriction, and not "the" project any more.
# ADO_PROJECT=your-project

# Optional "service" token used for background polling and project-wide reads.
# Scopes: Work Items (Read & Write), Code (Read), Project and Team (Read),
# Wiki (Read & Write).
# Each person signs in with their OWN token, and that token is what every write
# (log hours, set progress, state changes) runs under, so their name lands on
# their own changes. This one only backs shared reads. A project it can't read
# still works: that project's shared reads fall back to the token of whoever
# opened it (see server/scopes.js), which is also why leaving this empty is
# fine — the trade-off is that nothing is polled in the background.
# Wiki (Read & Write) is what lets the Team page's "Manage team" save: each
# project's org chart lives on that project's own `<project>.wiki` page.
# Create one at https://dev.azure.com/{org}/_usersSettings/tokens
#
# Leave this value empty in any copy of this file you commit — your real token belongs only in
# your own local, git-ignored .env, never in .env.example.
ADO_PAT=

# Optional overrides
ADO_API_VERSION=7.1
PORT=5174
# Bind address. Leave as 127.0.0.1 for local/IIS use. Containerized deployments
# (see Dockerfile) set this to 0.0.0.0 so the platform's proxy can reach it.
HOST=127.0.0.1
# Background poll interval for your own dashboard. Writes (log hours, state/
# sprint changes) still refresh immediately regardless of this value.
SYNC_INTERVAL_MS=900000
# Max concurrent requests to Azure DevOps, shared across every sync/write in
# the app. Azure DevOps throttles per identity (the PAT) — if you see
# "exceeded our rate limiting thresholds" in the server log, turn this down
# before anything else.
ADO_MAX_CONCURRENCY=6
# How many months of closed PR history to attribute/show on the Pull
# Requests page (a PR still `active` is always kept, regardless of age).
# Attribution is 2 ADO requests per PR, so this is the main lever on a cold
# sync's speed for anyone with a long PR history. Set to 0 for no cutoff
# (full history, the old default behavior).
ADO_PR_HISTORY_MONTHS=12
# How many projects stay resident at once. Each one holds its own sync engine
# and revision index, which is where the memory goes; idle ones are dropped and
# repaint from disk when reopened.
MAX_PROJECT_SCOPES=8

# Optional: the AES key behind every session cookie. When unset, one is
# generated and persisted to data/session-secret so local sessions survive a
# restart — set it explicitly in production, where a host with no persistent
# disk would otherwise regenerate it (and sign everyone out) on every deploy.
# Generate with `openssl rand -base64 32`. Rotating this instantly signs
# everyone out — it's the only "revoke all sessions" lever, since sessions are
# a self-contained encrypted cookie, not a server-side session store.
# SESSION_SECRET=
# How long a signed-in session lasts before needing the password + PAT again.
SESSION_TTL_HOURS=720

# Optional: who can clear a project's cache and trigger a full resync from the
# account menu ("Clear Cache" / "Reload All Data") — both actions are
# destructive/expensive and project-wide, not per-person. This is the
# deployment's owner, and is the owner in every project. Defaults to the
# service ADO_PAT's own identity when unset; a project whose reads fall back to
# a person's own token has no owner at all unless this is set.
# ADO_OWNER_EMAIL=you@yourorg.com

# Optional: the page (on each project's own wiki) holding that project's org
# chart — who's a lead/principal/scrum, and who reports to whom. Defaults to
# "/Dashboard Roles". The wiki NAME is always `<project>.wiki`, derived per
# project, which is what keeps each project's teams separate. Edited from the
# Team page's "Manage team" button — see server/orgStore.js.
# ADO_ROLES_WIKI_PAGE=/Dashboard Roles

# Optional: where the local fallback copies of the org charts live (one file per
# project). Defaults to data/org/ in the repo root (git-ignored, and
# deliberately outside .cache/ so clearing the cache never wipes them). The
# durable copy is the wiki page either way.
# ORG_DATA_DIR=./data/org
